+    /// What the screen shows: the key if there is one, else the old sentence.
+    pub fn what_msg(&self) -> Msg {
+        match &self.what_key {
+            Some(key) => Msg {
+                key: key.clone(),
+                params: self.what_params.clone(),
+            },
+            None => Msg::new("op.legacy").with("text", self.what.clone()),
+        }
