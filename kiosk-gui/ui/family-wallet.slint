import { Theme } from "theme.slint";
import { Message, Messages } from "messages.slint";
import { SidePanel, SecondaryButton } from "components.slint";
import { BeneficiaryItem, BeneficiaryGrid } from "my-wallet.slint";

export component FamilyWalletScreen inherits Rectangle {
    in property <string> balance-text: "0";
    in property <Message> balance-message: Message.none;
    in property <[BeneficiaryItem]> beneficiaries: [];

    callback beneficiary-selected(int);
    callback back-to-my-wallet-requested();
    callback help-requested();

    background: Theme.bg;

    HorizontalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;

        SidePanel {
            title: @tr("Family wallet");
            value: root.balance-message == Message.none ? root.balance-text : Messages.text(root.balance-message, "");

            // Same spot as MyWalletScreen's "Family wallet" button —
            // spec: consistent navigation (WCAG 3.2.3/3.2.4).
            SecondaryButton {
                text: @tr("Back to my wallet");
                on-dark: true;
                font-size: 20px;
                min-height: 72px;
                clicked => { root.back-to-my-wallet-requested(); }
            }

            SecondaryButton {
                text: "?   " + @tr("Help");
                label: @tr("Help");
                on-dark: true;
                clicked => { root.help-requested(); }
            }
        }

        BeneficiaryGrid {
            items: root.beneficiaries;
            selected(id) => { root.beneficiary-selected(id); }
        }
    }
}
