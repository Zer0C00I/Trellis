import { Theme } from "theme.slint";
import { Message, Messages } from "messages.slint";
import { SidePanel, SecondaryButton, Tile } from "components.slint";

export struct BeneficiaryItem {
    name: string,
    id: int,
}

// Up to 10 people as a two-column grid of large tiles, so the whole list
// fits the 480px screen without scrolling.
export component BeneficiaryGrid inherits Rectangle {
    in property <[BeneficiaryItem]> items: [];
    callback selected(int);

    property <length> gap: 14px;
    property <length> top: 58px;
    property <length> tile-w: (self.width - gap) / 2;
    property <length> tile-h: 64px;

    Text {
        x: 0;
        y: 0;
        text: @tr("Who to send to?");
        color: Theme.fg;
        font-size: 34px;
        font-weight: 600;
    }

    if root.items.length == 0 : Text {
        x: 0;
        y: root.top;
        width: root.width;
        text: @tr("No one to send to yet. A new recipient appears here 48 hours after being added.");
        color: Theme.muted;
        font-size: Theme.font-size-label;
        wrap: word-wrap;
    }

    for b[i] in root.items : Tile {
        x: Math.mod(i, 2) * (root.tile-w + root.gap);
        y: root.top + Math.floor(i / 2) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
        text: b.name;
        font-size: 22px;
        clicked => { root.selected(b.id); }
    }
}

export component MyWalletScreen inherits Rectangle {
    in property <string> balance-text: "0";
    // When not `none`, shown instead of the balance (the last fetch failed).
    in property <Message> balance-message: Message.none;
    in property <[BeneficiaryItem]> beneficiaries: [];

    callback beneficiary-selected(int);
    callback family-wallet-requested();
    callback help-requested();

    background: Theme.bg;

    HorizontalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;

        SidePanel {
            title: @tr("My wallet");
            value: root.balance-message == Message.none ? root.balance-text : Messages.text(root.balance-message, "");

            // Navigates rather than moves money, so it is outlined, not filled.
            SecondaryButton {
                text: @tr("Family wallet");
                on-dark: true;
                min-height: 72px;
                clicked => { root.family-wallet-requested(); }
            }

            // Help: fixed bottom of the panel on every wallet screen (spec: 3.2.6).
            SecondaryButton {
                text: "?   " + @tr("Help");
                label: @tr("Help");
                on-dark: true;
                clicked => { root.help-requested(); }
            }
        }

        BeneficiaryGrid {
            items: root.beneficiaries;
            selected(id) => { root.beneficiary-selected(id); }
        }
    }
}
