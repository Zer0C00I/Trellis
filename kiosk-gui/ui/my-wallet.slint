import { Theme } from "theme.slint";
import { KioskButton } from "button.slint";
import { Message, Messages } from "messages.slint";

export struct BeneficiaryItem {
    name: string,
    id: int,
}

export component MyWalletScreen inherits Rectangle {
    in property <string> balance-text: "0";
    // When not `none`, shown instead of the balance (the last fetch failed).
    in property <Message> balance-message: Message.none;
    in property <[BeneficiaryItem]> beneficiaries: [];

    callback beneficiary-selected(int);
    callback family-wallet-requested();
    callback help-requested();

    background: Theme.bg;

    HorizontalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: Theme.spacing;

            Text {
                text: @tr("My wallet");
                color: Theme.fg;
                font-size: Theme.font-size-heading;
            }

            Text {
                text: balance-message == Message.none ? balance-text : Messages.text(balance-message, "");
                color: Theme.fg;
                font-size: Theme.font-size-heading;
                wrap: word-wrap;
            }

            for b in beneficiaries: KioskButton {
                text: b.name;
                clicked => { beneficiary-selected(b.id); }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // The right column holds the controls that are the same on every
        // screen, so the beneficiary list never runs under them.
        VerticalLayout {
            width: 200px;
            spacing: Theme.spacing;

            // Distinct from the beneficiary list: it navigates, it moves no funds.
            KioskButton {
                text: @tr("Family wallet");
                primary: false;
                clicked => { family-wallet-requested(); }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                alignment: end;

                KioskButton {
                    text: "?";
                    primary: false;
                    font-size: Theme.font-size-heading;
                    min-width: Theme.target-size;
                    accessible-label: @tr("Help");
                    clicked => { help-requested(); }
                }
            }
        }
    }
}
