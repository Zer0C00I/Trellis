import { Theme } from "theme.slint";
import { Message, Messages } from "messages.slint";
import { SecondaryButton } from "components.slint";

export component SetupScreen inherits Rectangle {
    // In funding mode this is the funding QR; in pairing mode Rust swaps in
    // the pairing QR (the same property, so the Image element is shared).
    in property <image> qr-image;
    // Funding mode: what the kiosk is doing.
    in property <Message> message: Message.none;

    // Pairing mode: QR on the left, and on the right the instruction, the
    // fallback code for people who cannot scan, and a way to skip. The
    // kiosk has no input device for this step, so skipping is the only
    // control. See the family-app design spec, "Identity & Bootstrap".
    in property <bool> pairing-active: false;
    in property <string> pin-text: "";
    // Pairing mode: seconds of cooldown left (0: none).
    in property <int> pairing-wait-secs: 0;

    callback skip-pairing-requested();

    background: Theme.bg;

    HorizontalLayout {
        padding: Theme.margin;
        spacing: 32px;
        alignment: center;

        // White behind the QR keeps scanning contrast at its maximum.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 320px;
                height: 320px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.tile-border;
                background: #ffffff;

                Image {
                    source: root.qr-image;
                    width: 280px;
                    height: 280px;
                }
            }
        }

        VerticalLayout {
            spacing: Theme.spacing;
            alignment: center;
            width: 380px;

            Text {
                text: @tr("Device setup");
                color: Theme.fg;
                font-size: 34px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: root.pairing-active ? Messages.pairing-instruction(root.pairing-wait-secs) : Messages.text(root.message, "");
                color: Theme.fg;
                font-size: Theme.font-size-body;
                wrap: word-wrap;
            }

            if root.pairing-active : Rectangle {
                height: 96px;
                border-radius: Theme.radius;
                background: Theme.tile-bg;
                border-width: 1px;
                border-color: Theme.tile-border;

                Text {
                    text: root.pin-text;
                    color: Theme.fg;
                    font-family: "JetBrains Mono";
                    font-size: Theme.font-size-code;
                    font-weight: 700;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.pairing-active : SecondaryButton {
                text: @tr("Skip");
                font-size: Theme.font-size-body;
                clicked => { root.skip-pairing-requested(); }
            }
        }
    }
}
