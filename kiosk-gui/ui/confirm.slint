import { Theme } from "theme.slint";
import { Messages } from "messages.slint";
import { PrimaryButton, SecondaryButton } from "components.slint";

export component ConfirmScreen inherits Rectangle {
    in property <string> recipient-name: "";
    in property <string> amount-text: "";

    callback send-confirmed();
    callback send-cancelled();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.margin;
        spacing: Theme.spacing;

        Text {
            text: @tr("Check the transfer");
            color: Theme.fg;
            font-size: 34px;
            font-weight: 600;
        }

        // Amount and recipient on their own lines, each as large as it can be.
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.tile-border;
            background: Theme.tile-bg;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 32px;

                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Amount");
                            color: Theme.muted;
                            font-size: Theme.font-size-label;
                        }

                        Text {
                            text: root.amount-text;
                            color: Theme.fg;
                            font-size: Theme.font-size-code;
                            font-weight: 600;
                        }
                    }

                    Rectangle {
                        width: 2px;
                        background: Theme.tile-border;
                    }

                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("To");
                            color: Theme.muted;
                            font-size: Theme.font-size-label;
                        }

                        Text {
                            text: Messages.recipient(root.recipient-name);
                            color: Theme.fg;
                            font-size: Theme.font-size-heading;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            height: 84px;

            PrimaryButton {
                horizontal-stretch: 2;
                text: @tr("Send");
                clicked => { root.send-confirmed(); }
            }

            SecondaryButton {
                horizontal-stretch: 1;
                text: @tr("Cancel");
                font-size: Theme.font-size-body;
                clicked => { root.send-cancelled(); }
            }
        }
    }
}
