import { Theme } from "theme.slint";
import { KioskButton } from "button.slint";
import { Messages } from "messages.slint";

export component ConfirmScreen inherits Rectangle {
    in property <string> recipient-name: "";
    in property <string> amount-text: "";

    callback send-confirmed();
    callback send-cancelled();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;

        Text {
            text: @tr("Send {} → {}?", amount-text, Messages.recipient(recipient-name));
            color: Theme.fg;
            font-size: Theme.font-size-question;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.spacing;

            KioskButton {
                text: @tr("Send");
                clicked => { send-confirmed(); }
            }

            KioskButton {
                text: @tr("Cancel");
                primary: false;
                clicked => { send-cancelled(); }
            }
        }
    }
}
