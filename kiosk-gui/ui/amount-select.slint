import { Theme } from "theme.slint";
import { KioskButton } from "button.slint";
import { Messages } from "messages.slint";

export component AmountSelectScreen inherits Rectangle {
    in property <string> recipient-name: "";
    in property <[string]> presets: [];

    callback amount-selected(int);
    callback back-requested();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;

        Text {
            text: @tr("How much to send to {}?", Messages.recipient(recipient-name));
            color: Theme.fg;
            font-size: Theme.font-size-question;
            wrap: word-wrap;
        }

        for amount[i] in presets: KioskButton {
            text: amount;
            clicked => { amount-selected(i); }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            alignment: start;

            KioskButton {
                text: @tr("Back");
                primary: false;
                min-width: 140px;
                clicked => { back-requested(); }
            }
        }
    }
}
