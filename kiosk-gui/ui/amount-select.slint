import { Theme } from "theme.slint";
import { Messages } from "messages.slint";
import { SidePanel, SecondaryButton, Tile } from "components.slint";

export component AmountSelectScreen inherits Rectangle {
    in property <string> recipient-name: "";
    in property <[string]> presets: [];

    callback amount-selected(int);
    callback back-requested();

    background: Theme.bg;

    HorizontalLayout {
        padding: Theme.margin;
        spacing: Theme.margin;

        SidePanel {
            value: @tr("How much to send to {}?", Messages.recipient(root.recipient-name));
            value-size: 40px;

            // Same spot as the wallet switch on the wallet screens.
            SecondaryButton {
                text: @tr("Back");
                on-dark: true;
                font-size: Theme.font-size-body;
                clicked => { root.back-requested(); }
            }
        }

        VerticalLayout {
            spacing: 14px;
            alignment: start;

            Text {
                text: @tr("Choose an amount");
                color: Theme.fg;
                font-size: 34px;
                font-weight: 600;
            }

            for amount[i] in root.presets : Tile {
                height: 100px;
                text: amount;
                font-size: Theme.font-size-heading;
                clicked => { root.amount-selected(i); }
            }
        }
    }
}
