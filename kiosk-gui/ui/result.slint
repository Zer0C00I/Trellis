import { Theme } from "theme.slint";
import { Message, Messages } from "messages.slint";

export component ResultScreen inherits Rectangle {
    in property <bool> success: true;
    in property <Message> message: Message.none;
    // The recipient, for `Message.done`.
    in property <string> name: "";

    callback ok-pressed();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: center;

        Text {
            text: success ? "✓" : "✗";
            color: success ? Theme.success-color : Theme.error-color;
            font-size: 96px;
            horizontal-alignment: center;
        }

        Text {
            text: Messages.text(message, name);
            color: Theme.fg;
            font-size: Theme.font-size-heading;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            height: Theme.target-size;
            width: 200px;
            background: Theme.button-bg;
            border-radius: 8px;
            accessible-role: button;
            accessible-label: @tr("OK");

            TouchArea {
                clicked => { ok-pressed(); }
            }

            Text {
                text: @tr("OK");
                color: Theme.button-fg;
                font-size: Theme.font-size-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
