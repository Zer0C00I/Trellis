import { Theme } from "theme.slint";
import { KioskButton } from "button.slint";
import { Message, Messages } from "messages.slint";

export component ResultScreen inherits Rectangle {
    in property <bool> success: true;
    in property <Message> message: Message.none;
    // The recipient, for `Message.done`.
    in property <string> name: "";

    callback ok-pressed();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: center;

        Text {
            text: success ? "✓" : "✗";
            color: success ? Theme.success-color : Theme.error-color;
            font-size: 96px;
            horizontal-alignment: center;
        }

        Text {
            text: Messages.text(message, name);
            color: Theme.fg;
            font-size: Theme.font-size-heading;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;

            KioskButton {
                text: @tr("OK");
                min-width: 200px;
                clicked => { ok-pressed(); }
            }
        }
    }
}
